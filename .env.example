# 复制成 .env 后填入自己的 key。.env 已被 .gitignore 忽略，永远不要提交。
# pdfmend 本身不读取 .env 文件，下面这些只是环境变量的清单和用途说明。

# ---- LLM 字段抽取（pdfmend fields）----
# 选一个：deepseek（默认）| qwen（Qwen3-VL）| openai
PDFMEND_LLM_PROVIDER=deepseek
# 只设一个就够，PDFMEND_LLM_API_KEY 优先级最高
# DEEPSEEK_API_KEY=sk-你的key
# DASHSCOPE_API_KEY=sk-你的key
# 自建/代理时覆盖，默认用官方地址
# PDFMEND_LLM_BASE_URL=https://api.deepseek.com
# PDFMEND_LLM_MODEL=deepseek-chat
# PDFMEND_LLM_TIMEOUT=90

# ---- 扫描件 OCR ----
# 安装：pip install "pdfmend[ocr]"
# 注意：PaddleOCR 首次运行会下载模型到 ~/.paddleocr，需要联网一次
